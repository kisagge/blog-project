# ─────────────────────────────────────────────
# 필수
# ─────────────────────────────────────────────

# 데이터베이스 (SQLite)
DATABASE_URL="file:./dev.db"

# 관리자 로그인 비밀번호 (평문)
ADMIN_PASSWORD="change-me"

# 세션 JWT 서명 키 — `openssl rand -base64 32` 로 생성
SESSION_SECRET="generate-with-openssl-rand-base64-32"

# ─────────────────────────────────────────────
# 관리자 2FA (선택) — Google Authenticator TOTP
# 설정하면 로그인에 비밀번호 + OTP 6자리 필요. 미설정이면 비밀번호만.
# 시크릿 생성: `pnpm totp:setup`
# ─────────────────────────────────────────────

ADMIN_TOTP_SECRET=""

# ─────────────────────────────────────────────
# 이미지 업로드
# ─────────────────────────────────────────────

# 업로드 저장 디렉토리 (기본 data/uploads)
UPLOAD_DIR="data/uploads"

# ─────────────────────────────────────────────
# 던파 캐릭터 쇼케이스 (Neople OpenAPI)
# ─────────────────────────────────────────────

# https://developers.neople.co.kr 발급 키 (없으면 /df 기능 비활성)
NEOPLE_API_KEY=""

# ─────────────────────────────────────────────
# SNS 공유 (카카오)
# ─────────────────────────────────────────────

# Kakao JavaScript 키 (없으면 카카오 공유 버튼 비노출)
KAKAO_JS_KEY=""

# ─────────────────────────────────────────────
# 웹 푸시 알림 (VAPID) — `npx web-push generate-vapid-keys`
# ─────────────────────────────────────────────

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://example.com"   # mailto: 또는 사이트 URL

# ─────────────────────────────────────────────
# 메일 발송 (회원 비밀번호 재설정 코드) — SMTP (예: AWS SES)
# 미설정 시 메일은 콘솔 로그로 대체(개발용)
# ─────────────────────────────────────────────

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"           # 465면 true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BY Playground <no-reply@example.com>"

# ─────────────────────────────────────────────
# CAPTCHA (선택) — Cloudflare Turnstile (무료)
# 가입·로그인·비밀번호 재설정 요청에 사람 확인. 둘 다 미설정이면 비활성(위젯 미노출·검증 통과).
# 발급: https://dash.cloudflare.com → Turnstile → 사이트 추가
# ─────────────────────────────────────────────

TURNSTILE_SITE_KEY=""         # 공개 사이트키
TURNSTILE_SECRET_KEY=""       # 서버 검증용 시크릿
