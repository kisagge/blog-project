// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Feed {
  id        String   @id @default(uuid())
  slug      String   @unique   // URL 식별자: 소문자/숫자/하이픈 (검증은 작성 폼에서)
  title     String
  summary   String?
  content   String              // 본문 (마크다운/HTML 문자열로 저장)
  published Boolean  @default(false)   // 초안/공개 토글
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 사이트 전역 설정(싱글톤, id 항상 1).
model SiteConfig {
  id            Int      @id @default(1)
  publicEnabled Boolean  @default(true)   // false면 비어드민의 공개 사이트 접근 차단(점검 모드)
  updatedAt     DateTime @updatedAt
}