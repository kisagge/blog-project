// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Feed {
  id        String   @id @default(uuid())
  slug      String   @unique   // URL 식별자: 소문자/숫자/하이픈 (검증은 작성 폼에서)
  title     String
  summary   String?
  content   String              // 본문 (마크다운/HTML 문자열로 저장)
  visibility String  @default("private")   // "public" | "members" | "private"(초안)
  status    String   @default("published") // "draft"(임시저장) | "published". 회원 글의 작성 단계
  authorId  String?              // null=관리자/기존 글, 값=회원 작성자(User.id)
  viewCount Int      @default(0)        // 누적 조회수(방문자·하루 단위 중복 제거 후 집계)
  publishedAt DateTime?          // 게시(공개 전환) 시각 — 하루 게시 제한·표시용
  hiddenAt  DateTime?            // 신고로 가려진(모더레이션 숨김) 시각. null=정상. 사용자 삭제와 별개·복구 가능
  seriesId  String?              // 속한 시리즈(관리자 글만). null=미배정
  seriesOrder Int    @default(0) // 시리즈 내 순서(asc)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User?     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series    Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  feedTags  FeedTag[]

  // 목록 쿼리(searchFeeds): status=published + visibility IN + createdAt 정렬.
  @@index([status, visibility, createdAt])
  // 내 글/하루 게시(listMyPosts·countPublishedToday): authorId + status + publishedAt.
  @@index([authorId, status, publishedAt])
  // 시리즈 글 순서 조회(getSeriesPosts): seriesId + seriesOrder.
  @@index([seriesId, seriesOrder])
}

// 글 시리즈(관리자 큐레이션). slug로 유니크. 가시성은 포함 글에서 파생(태그 패턴).
model Series {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  feeds       Feed[]
}

// 태그 사전. slug로 유니크(한글 보존 정규화 키). name은 표시용 원형.
model Tag {
  id        String    @id @default(uuid())
  name      String              // 표시명 ("개발 후기")
  slug      String    @unique   // 정규화 키 ("개발-후기")
  createdAt DateTime  @default(now())
  feedTags  FeedTag[]
}

// 글-태그 다대다 조인 (Like/CommentLike 패턴).
model FeedTag {
  id        String   @id @default(uuid())
  feedId    String
  tagId     String
  createdAt DateTime @default(now())
  feed      Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([feedId, tagId])
  @@index([tagId])
}

// 사이트 전역 설정(싱글톤, id 항상 1).
model SiteConfig {
  id            Int      @id @default(1)
  publicEnabled Boolean  @default(true)   // false면 비어드민의 공개 사이트 접근 차단(점검 모드)
  updatedAt     DateTime @updatedAt
}

// 외부 회원(관리자 아님). status로 승인 흐름 관리.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  nickname     String
  bio          String?             // 자기소개(최대 160자, 선택)
  avatarUrl    String?             // 프로필 이미지 경로(/uploads/<uuid>.<ext>, 회원 업로드)
  passwordHash String              // "saltHex:hashHex" (scrypt)
  role         String   @default("member")    // "member" | "admin"(예약 작성자)
  status       String   @default("pending")   // "pending" | "approved" | "rejected"
  rejectionReason String?                      // 최근 거절 사유(재신청 시 관리자 참고용, 신청자엔 비노출)
  rejectedAt   DateTime?                        // 최근 거절 시각
  notifyOnReply   Boolean @default(true)        // 내 댓글에 답글 알림 수신 여부
  notifyOnComment Boolean @default(true)        // 내 글에 댓글 알림 수신 여부
  notifyOnMention Boolean @default(true)        // 댓글에서 @멘션 알림 수신 여부
  notifyOnFollow  Boolean @default(true)        // 누군가 나를 팔로우하면 알림 수신 여부
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  commentLikes CommentLike[]
  pushSubscriptions PushSubscription[]
  notifications Notification[]
  feeds     Feed[]
  reports   Report[]
  following  Follow[] @relation("follower")  // 내가 팔로우하는 관계
  followers  Follow[] @relation("following") // 나를 팔로우하는 관계
}

// 회원 간 팔로우(자기참조 다대다 조인). 팔로우 대상은 승인 회원만(앱 레이어 검증).
model Follow {
  id          String   @id @default(uuid())
  followerId  String   // 팔로우하는 회원
  followingId String   // 팔로우당하는 회원
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
}

// 인앱 알림(회원별). 답글 등 이벤트 시 생성, readAt로 읽음 관리.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 웹 푸시 구독(회원별, 기기별). endpoint 유니크.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 던파 쇼케이스에 노출할 캐릭터(관리자 등록). characterId는 Neople 고유 ID.
model DfCharacter {
  id            String   @id @default(uuid())
  serverId      String
  characterId   String
  characterName String
  sortOrder     Int      @default(0)
  viewCount     Int      @default(0)   // 누적 조회수
  visibility    String   @default("private")   // "public" | "members" | "private"
  createdAt     DateTime @default(now())

  @@unique([serverId, characterId])
}

// 조회 기록(중복 제거용). 같은 방문자·대상·날짜(KST)는 1건만 → viewCount 1 증가.
model View {
  id         String   @id @default(uuid())
  entityType String   // "feed" | "df"
  entityId   String
  visitorId  String
  day        String   // KST "YYYY-MM-DD"
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId, visitorId, day])
  @@index([entityType, entityId])
  @@index([entityType, day]) // countTodayVisitors(entityType="site", day) 커버
}

// 회원 비밀번호 재설정 6자리 코드(해시 저장). 이메일별 최신 1건만 유효.
model PasswordResetCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String              // scrypt(코드) — 평문 미저장
  expiresAt  DateTime            // 생성 + 3분
  attempts   Int       @default(0)   // 검증 시도 횟수(초과 시 무효)
  verifiedAt DateTime?           // 코드 검증 성공 시각
  consumedAt DateTime?           // 비밀번호 변경 완료 시각
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Comment {
  id        String    @id @default(uuid())
  feedId    String
  userId    String
  parentId  String?
  content   String
  deletedAt DateTime?
  hiddenAt  DateTime?           // 신고로 가려진(모더레이션 숨김) 시각. null=정상. 사용자 삭제(deletedAt)와 별개·복구 가능
  editedAt  DateTime?           // 작성자가 본문 수정한 시각. null=미수정("(수정됨)" 표시용)
  createdAt DateTime  @default(now())
  feed      Feed      @relation(fields: [feedId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
  parent    Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("replies")
  commentLikes CommentLike[]

  @@index([feedId])
  @@index([parentId])
  @@index([userId, createdAt])
}

// 콘텐츠 신고(댓글·회원 글). 관리자가 큐에서 검토해 숨김/기각.
model Report {
  id         String    @id @default(uuid())
  targetType String              // "comment" | "feed"
  targetId   String              // 대상 Comment.id / Feed.id
  reporterId String              // 신고한 회원(User.id)
  reason     String              // "spam" | "abuse" | "illegal" | "etc"
  detail     String?             // 선택 상세 설명(최대 500자)
  status     String    @default("pending") // "pending" | "resolved"(숨김 처리) | "dismissed"(기각)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, reporterId]) // 같은 회원의 동일 대상 중복 신고 방지
  @@index([status, createdAt])                  // 큐 조회
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
}

model Like {
  id        String   @id @default(uuid())
  feedId    String
  userId    String
  createdAt DateTime @default(now())
  feed      Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([feedId, userId])
}

// 북마크(개인 저장). 좋아요와 동형이나 공개 카운트·실시간 없는 개인용. createdAt=저장 시각.
model Bookmark {
  id        String   @id @default(uuid())
  feedId    String
  userId    String
  createdAt DateTime @default(now())
  feed      Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([feedId, userId])
  // 저장 목록(listSavedFeeds): where userId + orderBy createdAt desc.
  @@index([userId, createdAt])
}
// 관리자 거버넌스 액션 감사 로그(append-only). 관리자는 싱글톤이라 "누가"는 항상 관리자.
model AuditLog {
  id         String   @id @default(uuid())
  action     String   // "feed.create"·"member.block" 등 점 표기
  targetType String   // "feed" | "member" | "report" | "series" | "site" | "admin"
  targetId   String?
  summary    String   // 사람이 읽는 라벨(작성 시점 스냅샷 — 대상 삭제돼도 보존)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
