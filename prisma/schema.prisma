// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Feed {
  id        String   @id @default(uuid())
  slug      String   @unique   // URL 식별자: 소문자/숫자/하이픈 (검증은 작성 폼에서)
  title     String
  summary   String?
  content   String              // 본문 (마크다운/HTML 문자열로 저장)
  visibility String  @default("private")   // "public" | "members" | "private"(초안)
  status    String   @default("published") // "draft"(임시저장) | "published". 회원 글의 작성 단계
  authorId  String?              // null=관리자/기존 글, 값=회원 작성자(User.id)
  viewCount Int      @default(0)        // 누적 조회수(방문자·하루 단위 중복 제거 후 집계)
  publishedAt DateTime?          // 게시(공개 전환) 시각 — 하루 게시 제한·표시용
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User?     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]

  // 목록 쿼리(searchFeeds): status=published + visibility IN + createdAt 정렬.
  @@index([status, visibility, createdAt])
  // 내 글/하루 게시(listMyPosts·countPublishedToday): authorId + status + publishedAt.
  @@index([authorId, status, publishedAt])
}

// 사이트 전역 설정(싱글톤, id 항상 1).
model SiteConfig {
  id            Int      @id @default(1)
  publicEnabled Boolean  @default(true)   // false면 비어드민의 공개 사이트 접근 차단(점검 모드)
  updatedAt     DateTime @updatedAt
}

// 외부 회원(관리자 아님). status로 승인 흐름 관리.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  nickname     String
  passwordHash String              // "saltHex:hashHex" (scrypt)
  role         String   @default("member")    // "member" | "admin"(예약 작성자)
  status       String   @default("pending")   // "pending" | "approved" | "rejected"
  rejectionReason String?                      // 최근 거절 사유(재신청 시 관리자 참고용, 신청자엔 비노출)
  rejectedAt   DateTime?                        // 최근 거절 시각
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  comments  Comment[]
  likes     Like[]
  commentLikes CommentLike[]
  pushSubscriptions PushSubscription[]
  notifications Notification[]
  feeds     Feed[]
}

// 인앱 알림(회원별). 답글 등 이벤트 시 생성, readAt로 읽음 관리.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 웹 푸시 구독(회원별, 기기별). endpoint 유니크.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 던파 쇼케이스에 노출할 캐릭터(관리자 등록). characterId는 Neople 고유 ID.
model DfCharacter {
  id            String   @id @default(uuid())
  serverId      String
  characterId   String
  characterName String
  sortOrder     Int      @default(0)
  viewCount     Int      @default(0)   // 누적 조회수
  visibility    String   @default("private")   // "public" | "members" | "private"
  createdAt     DateTime @default(now())

  @@unique([serverId, characterId])
}

// 조회 기록(중복 제거용). 같은 방문자·대상·날짜(KST)는 1건만 → viewCount 1 증가.
model View {
  id         String   @id @default(uuid())
  entityType String   // "feed" | "df"
  entityId   String
  visitorId  String
  day        String   // KST "YYYY-MM-DD"
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId, visitorId, day])
  @@index([entityType, entityId])
}

// 회원 비밀번호 재설정 6자리 코드(해시 저장). 이메일별 최신 1건만 유효.
model PasswordResetCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String              // scrypt(코드) — 평문 미저장
  expiresAt  DateTime            // 생성 + 3분
  attempts   Int       @default(0)   // 검증 시도 횟수(초과 시 무효)
  verifiedAt DateTime?           // 코드 검증 성공 시각
  consumedAt DateTime?           // 비밀번호 변경 완료 시각
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Comment {
  id        String    @id @default(uuid())
  feedId    String
  userId    String
  parentId  String?
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  feed      Feed      @relation(fields: [feedId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
  parent    Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("replies")
  commentLikes CommentLike[]

  @@index([feedId])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
}

model Like {
  id        String   @id @default(uuid())
  feedId    String
  userId    String
  createdAt DateTime @default(now())
  feed      Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([feedId, userId])
}